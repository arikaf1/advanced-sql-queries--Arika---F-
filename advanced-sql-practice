SELECT * FROM customers;
SELECT * FROM orders;

SELECT orders.id, customers.first_name, customers.last_name, orders.order_total
FROM orders
INNER JOIN customers ON orders.customer_id = customers.id;

SELECT customers.id, customers.first_name, customers.last_name
FROM customers
LEFT JOIN orders ON customers.id = orders.customer_id
WHERE orders.customer_id IS NULL;

SELECT order_date, SUM(order_total) AS daily_revenue
FROM orders
GROUP BY order_date;

SELECT COUNT(*) AS completed_order_count
FROM orders
WHERE order_status = 'Completed';

SELECT customer_id, SUM(order_total) AS high_value_total
FROM orders
WHERE order_total > 15.00
GROUP BY customer_id;

SELECT customer_id, COUNT(id) AS total_orders_placed
FROM orders
GROUP BY customer_id
HAVING COUNT(id) > 1;

SELECT id, order_date, order_total
FROM orders
WHERE order_total = (SELECT MAX(order_total) FROM orders);

SELECT id, order_date, order_total, customer_id
FROM orders
WHERE customer_id IN (SELECT id FROM customers WHERE first_name LIKE 'M%' OR first_name LIKE 'A%');

SELECT order_date, order_total
FROM (SELECT id, order_date, order_total FROM orders WHERE order_status = 'Completed') AS completed_summary;
